# Radinkacraft — variabel lingkungan lokal dan produksi
# Connection string PostgreSQL pooler transaksi Supabase, port 6543, pgbouncer=true.
DATABASE_URL=
# Connection string session pooler Supabase, port 5432; dipakai migrasi.
DIRECT_URL=
# URL project Supabase, contoh https://xxxx.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=
# Kunci anon Supabase yang aman dipakai browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Kunci service role rahasia, hanya server; jangan bagikan.
SUPABASE_SERVICE_ROLE_KEY=
# URL publik situs, contoh https://radinkacraft.id.
NEXT_PUBLIC_SITE_URL=
# Nomor WhatsApp admin format internasional tanpa tanda +.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Garam acak rahasia untuk hash IP testimoni.
TESTIMONIAL_IP_SALT=
# API key Resend untuk email transaksional.
RESEND_API_KEY=
# Nama/alamat pengirim email terverifikasi.
EMAIL_FROM=
# Alamat email admin untuk notifikasi pembayaran.
ADMIN_EMAIL=
# Rahasia untuk melindungi route cron Vercel.
CRON_SECRET=